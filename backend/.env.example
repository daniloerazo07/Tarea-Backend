# El servicio de alojamiento configura estas variables; Node no carga este archivo automáticamente.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_ORIGIN=https://daniloerazo07.github.io
# Usa un secreto aleatorio de al menos 32 caracteres; nunca lo subas al repositorio.
SESSION_SECRET=
# En alojamiento externo, usa PostgreSQL para conservar pedidos entre reinicios.
DATABASE_URL=
# Opcional: carpeta con productos.json y pedidos.json en un disco persistente.
# DATA_DIRECTORY=/var/data/cafecat
